# Copy to .env for standalone development (docker compose up).
DATA_DIR=/data
UPLOAD_MAX_MB=500
RETENTION_HOURS=48
PLAYBACK_RETENTION_DAYS=30
RETENTION_SWEEP_MINUTES=30
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
AUDIO_FORMAT=wav
AUDIO_MP3_BITRATE=64k
PLAYBACK_BITRATE=96k
CHUNK_SEC_DEFAULT=600
CHUNK_MAX_MB_DEFAULT=24
CHUNK_BITRATE=64k
SPLIT_WINDOW_SEC=20
SILENCE_NOISE_DB=-30
SILENCE_MIN_SEC=0.3
# Checked on every POST/DELETE via X-API-Key (or Authorization: Bearer).
# Empty value disables the check - dev only.
API_KEY=change-me
LOG_LEVEL=INFO
# second request on a busy source waits this long, then 409 source_busy
SOURCE_LOCK_WAIT_SEC=600
