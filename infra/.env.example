# media-service
DATA_DIR=/data
UPLOAD_MAX_MB=200
RETENTION_HOURS=48
# a second /download or /split on the same source waits this long for the first, then 409 source_busy (about twice a 90-minute video end to end, below the 30-minute n8n timeout)
SOURCE_LOCK_WAIT_SEC=600
# direct file links: timeout of the redirect check and of each ffprobe read over HTTP
DIRECT_HEAD_TIMEOUT_SEC=15
PLAYBACK_RETENTION_DAYS=30
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
AUDIO_FORMAT=wav
API_KEY=change-me

# postgres
POSTGRES_USER=digest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=digest

# n8n
MEDIA_URL=http://media:8000
MEDIA_API_KEY=change-me
# API key of the n8n instance (Settings -> n8n API); used by n8n/scripts/*.sh and the server deploy
N8N_API_KEY=
# OpenAI whisper-1, 0.36 $/h. Groq whisper-large-v3 and turbo drop 15-20 s windows of speech (rejected 2026-09-16); prices in n8n/pricing.json
STT_PROVIDER=openai
STT_MODEL=whisper-1
STT_API_KEY=
# Deepgram nova-3, 0.26 $/h, no Whisper-style dropped windows (2026-09-16); STT_PROVIDER=deepgram STT_MODEL=nova-3 and this key in the n8n credential "Deepgram API" (scripts/credentials.sh --only deepgram)
DEEPGRAM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_MODEL_MAP=gpt-4o-mini
# reduce and critique: gpt-5.6-luna is 0.20/1.20 $ per 1M against 2.00/8.00 for gpt-4.1 and has 500k TPM on Tier 1; it accepts no temperature, see n8n/pricing.json
LLM_MODEL_REDUCE=gpt-5.6-luna
LLM_API_KEY=
MAX_JOB_MINUTES=60
# 90 minutes: lectures and podcasts run 60-90 min, refusing a normal video is worse than fewer jobs a day
MAX_DURATION_SEC=5400
# spending cap per sliding 24 hours, POST /api/jobs answers 429 daily_limit above it; a job reserves
# STT minutes x price + max(0.02, minutes x 0.0015) until it is done (constants in n8n, contract section 7)
# Cloudflare Turnstile on the run form (step E3): the secret goes into the n8n credential «Turnstile» via
# n8n/scripts/credentials.sh --only turnstile; the site key is VITE_TURNSTILE_SITE_KEY below.
TURNSTILE_SECRET=
# public site key of the same Turnstile widget; read by infra/deploy/deploy.sh when it builds the web image
# (--build-arg into infra/web.Dockerfile) and inlined into the bundle; empty: deploy.sh refuses to build
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=digest.inforobot.space,localhost
TURNSTILE_MODE=monitor
DAILY_BUDGET_USD=6.00
# jobs in queued/processing at once, POST /api/jobs answers 429 busy at the limit
MAX_CONCURRENT_JOBS=2
RESULT_RETENTION_DAYS=30
# events table (infra/sql/002_events.sql): rows older than this are deleted on every insert
EVENTS_RETENTION_DAYS=7
# n8n execution data (stage inputs and outputs, transcripts included) in hours: 7 days, shorter than any visible copy of the content
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE=true
PUBLIC_URL=https://example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true for SMTPS (465)
SMTP_SECURE=false
# HTML -> PDF service for the exports; the default is the gotenberg service from compose, change it only for an external one
GOTENBERG_URL=http://gotenberg:3000
# OpenAI-compatible base URLs, used only when LLM_PROVIDER / STT_PROVIDER is not one with a built-in URL
# (LLM: openai, groq, openrouter; STT: openai, groq, deepgram), for example an in-house server
# LLM_BASE_URL=http://localhost:8080/v1   # default
# STT_BASE_URL=http://localhost:8080/v1   # default

# the remaining media-service variables (chunking, silence detection, timeouts, binaries, log level) with their defaults: media-service/.env.example
