      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "name": "VideoDigest Postgres"
        }
      },
      "id": "82d800ab-499f-42a9-9412-3ae906bd1bc5",
      "name": "Stuck jobs",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [Number($env.MAX_JOB_MINUTES || 60)] }}"
        },
        "query": "select id, stages, created_at, coalesce((select value::numeric from settings where key = 'MAX_JOB_MINUTES' and value ~ '^[0-9]+(\\.[0-9]+)?$'), $1::numeric) as max_job_minutes from jobs where status in ('queued', 'processing') and created_at < now() - (coalesce((select value::numeric from settings where key = 'MAX_JOB_MINUTES' and value ~ '^[0-9]+(\\.[0-9]+)?$'), $1::numeric) * interval '1 minute')"
      },
      "position": [
        220,
        300
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7
    },
    {
      "id": "5ff12613-9a7d-4df2-8b62-848ee5e57cbf",
      "name": "Timeout items",
      "parameters": {
        "jsCode": "// One item per stuck job: the running (or first pending) stage becomes failed, error carries the reason.\nreturn $input.all().map((i) => i.json).filter((r) => r && r.id).map((r) => {\n  const minutes = Number(r.max_job_minutes) || Number($env.MAX_JOB_MINUTES || 60);\n  const stages = Array.isArray(r.stages) ? r.stages : [];\n  const stuck = stages.find((s) => s.status === 'running') || stages.find((s) => s.status === 'pending') || { name: 'pipeline' };\n  const newStages = stages.map((s) => (s.name === stuck.name ? { ...s, status: 'failed' } : s));\n  const message = `job exceeded MAX_JOB_MINUTES=${minutes}: stuck at ${stuck.name} since ${r.created_at}`;\n  return { json: {\n    job_id: r.id, p_error: JSON.stringify({ stage: stuck.name, code: 'timeout', message: 'processing took too long' }), p_stages: JSON.stringify(newStages),\n    events: [{ type: 'job_timeout', level: 'error', stage: stuck.name, body: message }],\n  } };\n});\n"
      },
      "position": [
        440,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "postgres": {
          "name": "VideoDigest Postgres"
        }
      },
      "id": "fc66c638-d13d-41b3-8d97-bb9374bbbfb4",
      "name": "Mark timed out",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$json.job_id, $json.p_error, $json.p_stages] }}"
        },
        "query": "update jobs set status = 'failed', error = $2::jsonb, stages = $3::jsonb, finished_at = now(), updated_at = now() where id = $1 and status in ('queued', 'processing')"
      },
      "position": [
        660,
        300
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7
    },
    {
      "id": "076802d5-781a-4b4f-bea5-0847d3d88054",
      "name": "Restore timeout item",
      "parameters": {
        "jsCode": "// Postgres replaced the items; put them all back for the events log.\nreturn $('Timeout items').all();"
      },
      "position": [
        880,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "49ecd660-ca2f-4041-b76c-2c9e0350c333",
      "name": "Log timeout",
      "parameters": {
        "options": {
          "waitForSubWorkflow": false
        },
        "workflowId": {
          "__rl": true,
          "cachedResultName": "log-events",
          "mode": "list",
          "value": ""
        },
