          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [
            {
              "canBeUsedToMatch": true,
              "defaultMatch": false,
              "display": true,
              "displayName": "job_id",
              "id": "job_id",
              "removed": false,
              "required": false,
              "type": "string"
            },
            {
              "canBeUsedToMatch": true,
              "defaultMatch": false,
              "display": true,
              "displayName": "events",
              "id": "events",
              "removed": false,
              "required": false,
              "type": "array"
            }
          ],
          "value": {
            "events": "={{ $json.events || [] }}",
            "job_id": "={{ $json.job_id || ($json.job && $json.job.id) || '' }}"
          }
        }
      },
      "position": [
        1100,
        300
      ],
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3
    },
    {
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "name": "VideoDigest Postgres"
        }
      },
      "id": "70d994bf-4a3a-4e8d-81da-09f2f9252764",
      "name": "Expire results",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [Number($env.RESULT_RETENTION_DAYS || 30)] }}"
        },
        "query": "select id, status, source_id, source, meta, error, finished_at from jobs where status in ('done', 'failed') and finished_at < now() - make_interval(days => $1) and (meta->>'expired_at') is null"
      },
      "position": [
        220,
        0
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7
    },
    {
      "id": "f295e9bb-26ce-47d8-8c29-febc0e96b49a",
      "name": "Expired items",
      "parameters": {
        "jsCode": "// One item per expired job: reduced source/meta/error for the update, the original source_id for the media delete.\nconst days = Number($env.RESULT_RETENTION_DAYS || 30);\nconst now = new Date().toISOString();\nreturn $input.all().map((i) => i.json).filter((r) => r && r.id).map((r) => {\n  const src = r.source || {};\n  const source = { type: src.type || null, platform: src.platform || null, duration_sec: src.duration_sec ?? null, language: src.language || null, title: null, url: null, thumbnail_url: null };\n  const meta = { ...(r.meta || {}) };\n  delete meta.quality_warnings;\n  if (Array.isArray(meta.stages)) meta.stages = meta.stages.map((st) => { const { dropped_quotes, ...rest } = st || {}; return rest; });\n  meta.expired_at = now;\n  const error = r.error && typeof r.error === 'object' ? { stage: r.error.stage || null, code: r.error.code || null } : null;\n  return { json: {\n    job_id: r.id, source_id: r.source_id,\n    p_source: JSON.stringify(source), p_meta: JSON.stringify(meta), p_error: JSON.stringify(error),\n    events: [{ type: 'result_expired', level: 'info', stage: 'maintenance', body: `${r.status} job expired: finished ${r.finished_at}, retention ${days} days; content and identifying fields removed` }],\n  } };\n});\n"
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "Media Service API"
        }
      },
      "id": "a32bf583-d79e-49bd-8a75-a77d54e5b87f",
      "name": "Media delete expired",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "method": "DELETE",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
